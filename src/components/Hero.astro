---
import { site } from '../data/site.config';
import images from '../data/images.json';
import { img } from '../lib/img';
import { localImage } from '../lib/localImage';
const { eyebrow, title, subtitle, backgroundImage } = site.hero;
// 합성 히어로: 차량 이미지(배경) + 딜러 누끼 사진(전면 포트레이트)
const heroCar = img(images.hero ?? localImage('hero') ?? backgroundImage ?? images.models?.grandeur);
// 배경(차량 사진) 위에 얹으므로 흰 배경을 지운 누끼 이미지를 우선 사용한다.
const dealerSrc = localImage('profile-cutout') ?? images.profile ?? localImage('profile');
const hasDealerPhoto = Boolean(img(dealerSrc));
const dealerPhoto = img(dealerSrc) ?? `${import.meta.env.BASE_URL}images/dealer-profile.svg`;
const titleLines = title.split('\n');
const subtitleLines = subtitle.split('\n');
---

<section class="hero" id="top">
  <div
    class="hero__bg"
    data-photo={heroCar ? 'true' : undefined}
    style={heroCar ? `background-image:url('${heroCar}')` : undefined}
  >
    <div class="hero__grid"></div>
    <div class="hero__glow"></div>
  </div>

  {!heroCar && (
    <img
      class="hero__car"
      src={`${import.meta.env.BASE_URL}images/car-silhouette.svg`}
      alt=""
      aria-hidden="true"
    />
  )}

  <div class="hero__inner container">
    <div class="hero__copy">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h1 class="display hero__title" data-reveal data-reveal-delay="1">
        {titleLines.map((line, i) => (
          <>{line}{i < titleLines.length - 1 && <br />}</>
        ))}
      </h1>
      <p class="lead hero__sub" data-reveal data-reveal-delay="2">
        {subtitleLines.map((line, i) => (
          <>{line}{i < subtitleLines.length - 1 && <br />}</>
        ))}
      </p>
      <div class="hero__cta" data-reveal data-reveal-delay="3">
        <a class="btn btn--primary" href="#contact">상담 신청하기</a>
        <a class="btn btn--ghost" href="#models">차종 둘러보기</a>
      </div>
    </div>

    <figure class="hero__dealer" data-photo={hasDealerPhoto ? 'true' : undefined} data-reveal data-reveal-delay="2">
      <img class="hero__dealer-photo" src={dealerPhoto} alt={`${site.dealer.name} ${site.dealer.role}`} />
      <figcaption class="hero__card">
        <strong class="hero__card-name">{site.dealer.name}<em>{site.dealer.role}</em></strong>
        <span class="hero__card-shop">{site.dealer.dealership}</span>
        <a class="hero__card-tel" href={`tel:${site.contact.phone.replace(/-/g, '')}`}>
          {site.contact.phone}
        </a>
      </figcaption>
    </figure>
  </div>

  <a class="hero__scroll" href="#about" aria-label="아래로 스크롤">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    color: #fff;
    background: var(--ink);
    overflow: hidden;
  }
  .hero__bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    background-color: var(--ink);
  }
  /* 실제 차량 사진일 때는 인물/피사체가 명함 카드와 겹치지 않도록 왼쪽(차량 쪽)으로 초점 이동 */
  .hero__bg[data-photo] { background-position: 22% center; }
  .hero__bg::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 78% 8%, rgba(0, 170, 210, 0.28), transparent 55%),
      radial-gradient(90% 80% at 12% 100%, rgba(0, 44, 95, 0.55), transparent 60%),
      linear-gradient(180deg, #06070a 0%, #0a0c10 45%, #05070b 100%);
  }
  /* 실제 차량 사진 배경일 때 가독성 오버레이 */
  .hero__bg[data-photo]::before {
    background:
      linear-gradient(90deg, rgba(5, 7, 11, 0.85) 0%, rgba(5, 7, 11, 0.5) 52%, rgba(5, 7, 11, 0.22) 100%),
      linear-gradient(0deg, rgba(5, 7, 11, 0.72), rgba(5, 7, 11, 0.05) 60%);
  }
  .hero__grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(120% 100% at 50% 0%, #000 30%, transparent 78%);
  }
  .hero__glow {
    position: absolute;
    width: 70vw; height: 70vw; max-width: 760px; max-height: 760px;
    right: -10vw; top: 8%;
    background: radial-gradient(circle, rgba(0, 170, 210, 0.22), transparent 62%);
    filter: blur(20px);
    pointer-events: none;
  }
  /* 차량 사진이 없을 때의 실루엣 백드롭 */
  .hero__car {
    position: absolute; z-index: 1;
    left: 50%; bottom: 6%;
    transform: translateX(-50%);
    width: min(78%, 880px);
    opacity: 0.5;
    filter: drop-shadow(0 30px 60px rgba(0, 170, 210, 0.25));
    pointer-events: none;
  }

  .hero__inner {
    position: relative; z-index: 2;
    padding-block: 124px 100px;
    display: grid;
    /* 인물은 필요한 폭만 쓰고, 남는 폭은 전부 카피에 준다(제목 줄바꿈 방지) */
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    width: 100%;
  }
  .hero__title { margin-top: 22px; max-width: 16ch; }
  .hero__sub { margin-top: 26px; color: rgba(255, 255, 255, 0.72); max-width: 52ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 40px; }

  /* 누끼 인물 — 카드 박스 없이 배경 위에 그대로 세운다(배경 사진과 충돌 방지) */
  .hero__dealer {
    margin: 0;
    position: relative;
    justify-self: end;
    align-self: end;
    width: auto;
  }
  .hero__dealer-photo {
    display: block;
    /* 폭이 아니라 높이를 기준으로 잡아야 히어로 밖으로 넘치지 않는다 */
    height: min(70vh, 660px);
    width: auto;
    max-width: 100%;
    /* 어두운 배경에서 남색 정장이 묻히지 않도록 분리감을 준다 */
    filter:
      drop-shadow(0 26px 46px rgba(0, 0, 0, 0.62))
      drop-shadow(0 0 70px rgba(0, 170, 210, 0.18));
    /* 허벅지에서 잘린 원본 하단을 부드럽게 페이드 — 잘린 느낌 제거 */
    -webkit-mask-image: linear-gradient(180deg, #000 76%, rgba(0, 0, 0, 0) 99%);
    mask-image: linear-gradient(180deg, #000 76%, rgba(0, 0, 0, 0) 99%);
  }
  /* 누끼 뒤 은은한 광원 — 인물과 배경 차량을 시각적으로 분리 */
  .hero__dealer::before {
    content: '';
    position: absolute;
    left: 50%; bottom: 8%;
    width: 78%; aspect-ratio: 1;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(0, 170, 210, 0.20), transparent 68%);
    filter: blur(26px);
    z-index: -1;
    pointer-events: none;
  }

  /* 연락처 배지 (기존엔 사진에 박혀 있던 명함 정보를 HTML 로 분리) */
  .hero__card {
    position: absolute;
    left: -16px;
    bottom: 30px;
    padding: 14px 22px 15px;
    border-radius: 16px;
    background: rgba(8, 14, 30, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 22px 50px -18px rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(14px) saturate(1.25);
  }
  .hero__card-name { display: block; font-size: 1.16rem; font-weight: 800; letter-spacing: -0.02em; }
  .hero__card-name em {
    font-style: normal; font-weight: 600; font-size: 0.68rem;
    letter-spacing: 0.1em; color: var(--accent); margin-left: 9px;
    vertical-align: middle;
  }
  .hero__card-shop { display: block; margin-top: 3px; font-size: 0.8rem; color: rgba(255, 255, 255, 0.66); }
  .hero__card-tel {
    display: inline-block; margin-top: 8px;
    font-size: 1.12rem; font-weight: 800; letter-spacing: 0.5px;
    color: #fff; text-decoration: none;
  }
  .hero__card-tel:hover { color: var(--accent); }

  .hero__scroll {
    position: absolute; left: 50%; bottom: 30px; transform: translateX(-50%);
    width: 26px; height: 42px; border: 2px solid rgba(255, 255, 255, 0.4);
    border-radius: 14px; z-index: 2;
  }
  .hero__scroll span {
    position: absolute; left: 50%; top: 8px; transform: translateX(-50%);
    width: 4px; height: 8px; border-radius: 2px; background: #fff;
    animation: scrollcue 1.8s var(--ease) infinite;
  }
  @keyframes scrollcue {
    0% { opacity: 0; transform: translate(-50%, 0); }
    40% { opacity: 1; }
    80%, 100% { opacity: 0; transform: translate(-50%, 14px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll span { animation: none; }
  }

  @media (max-width: 880px) {
    .hero__inner {
      grid-template-columns: 1fr;
      padding-block: 110px 88px;
      gap: 40px;
    }
    .hero__cta .btn { flex: 1 1 auto; }
    .hero__car { width: 120%; opacity: 0.32; bottom: 2%; }
    /* 좁은 화면에서는 사진의 가시 폭이 줄어드니 차량이 잘리지 않도록 초점을 조금 더 안쪽으로 */
    .hero__bg[data-photo] { background-position: 38% center; }

    /* 세로 배치: 인물을 가운데로 줄이고, 배지는 겹치지 않게 인물 아래로 흘려보낸다
       (절대배치로 두면 하단 고정 CTA 바에 가려짐) */
    .hero__dealer { justify-self: center; width: auto; }
    .hero__dealer-photo { height: min(44vh, 360px); }
    .hero__card {
      position: static;
      transform: none;
      width: max-content;
      margin: -14px auto 0;
      padding: 12px 22px 13px;
      text-align: center;
    }
  }
</style>
